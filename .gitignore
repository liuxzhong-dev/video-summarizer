# 构建产物（所有历史版本目录，每个约 300 MB，只留磁盘不进 Git）
# 用通配而非逐版列举：旧写法只列到 v15，导致 v16~v19 的 build/dist 被误跟踪
build*/
dist*/
out*/
*.spec.bak

# 临时验证用（CDP 浏览器 profile、截图、一次性脚本）
_edgeprof*/
_shot_*.png
_cdp*.js
_testvault/
_diag*.py

# 运行期生成
config.json
out/
*.log
rag_store/

# 内置浏览器内核副本（219 MB，由 tools/prepare_browser_vendor.py 生成本地生成，不入库）
vendor/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
